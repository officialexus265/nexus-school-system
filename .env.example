# Copy this file to .env.local for local development. On Vercel, set these
# under Project Settings -> Environment Variables instead.

# --- Database (required in production) ---------------------------------
# Any standard Postgres connection string works: Neon, Supabase, Vercel
# Postgres, Railway, your own box, etc.
# Leave unset locally and the app falls back to an embedded, in-memory
# Postgres (PGLite) - fine for local dev, NOT for production (data is wiped
# on every restart).
DATABASE_URL=

# --- Auth (Better Auth) ---------------------------------------------------
# Set VITE_AUTH_ENABLED="false" to turn sign-in off entirely and use a single
# shared dev user (local prototyping only - refuses to run if DATABASE_URL is
# also set, so you can't accidentally ship this).
VITE_AUTH_ENABLED=true

# Required once deployed: a long random secret, stable across deploys.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Required once deployed: this app's public URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=

# Email/password sign-in is ON by default (src/lib/auth/email-password.ts) -
# no extra setup needed for it to work.

# --- Optional: Google sign-in ---------------------------------------------
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also flip this so the client renders the "Continue with Google" button:
VITE_GOOGLE_AUTH_ENABLED=false

# --- Optional: GitHub sign-in ----------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_AUTH_ENABLED=false
