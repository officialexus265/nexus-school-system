DATABASE_URL=

VITE_AUTH_ENABLED=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

VITE_GOOGLE_AUTH_ENABLED=false

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_AUTH_ENABLED=false

# --- SMS (optional) ---
# demo (default) | africastalking | twilio
SMS_PROVIDER=demo

# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_FROM=NEXUS

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email (optional) ---
# demo (default) | resend
EMAIL_PROVIDER=demo
RESEND_API_KEY=
EMAIL_FROM=NEXUS <onboarding@resend.dev>

# --- httpSMS (recommended) ---
# Platform owner account — invoice SMS to schools
PLATFORM_HTTPSMS_API_KEY=
PLATFORM_HTTPSMS_FROM=

# Optional global fallback for school SMS when school has no own account
HTTPSMS_API_KEY=
HTTPSMS_FROM=
SMS_PROVIDER=httpsms

# --- Object storage (optional) ---
STORAGE_PROVIDER=local
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- PayChangu (Malawi: mobile money, bank, card) ---
# Get keys: https://in.paychangu.com/user/api
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
# Webhook URL to set in dashboard: https://YOUR_DOMAIN/api/paychangu/webhook


# Demo school seed (Sunrise Academy) has been removed from the product.

# --- Push (FCM) optional ---
FCM_SERVER_KEY=
# Web client (also: npm i firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Cron / hands-off jobs: Authorization Bearer or ?secret=
CRON_SECRET=


# --- Email: Resend OR SMTP ---
# EMAIL_PROVIDER=resend | smtp | demo
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=NEXUS <noreply@yourdomain.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
